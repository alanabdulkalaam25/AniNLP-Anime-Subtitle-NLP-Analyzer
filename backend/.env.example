# Comma-separated frontend origins permitted to call the API.
# No trailing slashes. Add every deployed frontend origin, for example:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: regex for origins you cannot list individually, such as
# Vercel preview deployments. Keep it scoped to your Vercel project.
# CORS_ORIGIN_REGEX=https://your-project-[a-z0-9-]+-your-team\.vercel\.app

# Public analysis protection: 10 requests per client per 60 seconds.
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=60

# Upload and processing limits.
# MAX_UPLOAD_SIZE_BYTES=10485760
# MAX_SUBTITLE_TEXT_CHARS=500000
# ANALYSIS_TIMEOUT_SECONDS=30
# MAX_CONCURRENT_ANALYSES=1
